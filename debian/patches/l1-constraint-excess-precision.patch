From: Barak A. Pearlmutter <bap@debian.org>
Forwarded: https://github.com/mlpack/ensmallen/pull/464
Description: L1Constraint::ProximalStep() re-projects onto a slightly smaller
 ball if floating-point error left the result outside the ball.  With excess
 floating-point precision (x87 on i386), newNorm can compare greater than
 lambda while newLambda, once stored in a double, rounds back to lambda
 exactly.  The recursion then never makes progress and overflows the stack,
 which caused SIGSEGV in the L1ConstraintProjectionTest and
 FASTAWoodFunctionTest tests on i386.  Force the new radius to be a few ULPs
 of the element type smaller than the old one.

diff --git a/include/ensmallen_bits/fbs/l1_constraint_impl.hpp b/include/ensmallen_bits/fbs/l1_constraint_impl.hpp
index aff3ed2f..3b63241a 100644
--- a/include/ensmallen_bits/fbs/l1_constraint_impl.hpp
+++ b/include/ensmallen_bits/fbs/l1_constraint_impl.hpp
@@ -162,7 +162,14 @@ void L1Constraint::ProximalStep(MatType& coordinates,
           5 * (eT(lambda) - eT(std::nexttoward(lambda, 0.0)));
     }
 
-    L1Constraint newConstraint(newLambda);
+    // Guarantee that the radius strictly decreases by a few ULPs of eT.
+    // Otherwise excess floating-point precision (e.g. x87 on i386) can make
+    // newNorm compare greater than lambda while newLambda rounds back to
+    // lambda when stored, causing unbounded recursion and a stack overflow.
+    const double eps = std::max((double) std::numeric_limits<eT>::epsilon(),
+        (double) std::numeric_limits<double>::epsilon());
+    L1Constraint newConstraint(std::min((double) newLambda,
+        lambda * (1.0 - 4 * eps)));
     newConstraint.ProximalStep(coordinates, 0.0 /* ignored */);
   }
 }
